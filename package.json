{
  "name": "dontsue",
  "version": "0.1.0",
  "description": "Flags apps that collect personal data without a privacy policy, terms of service, or cookie consent.",
  "type": "module",
  "bin": {
    "dontsue": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "privacy",
    "gdpr",
    "ccpa",
    "privacy-policy",
    "cookie-consent",
    "linter",
    "compliance"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mido4499/dontsue.git"
  },
  "homepage": "https://github.com/mido4499/dontsue#readme",
  "bugs": {
    "url": "https://github.com/mido4499/dontsue/issues"
  },
  "dependencies": {
    "@babel/parser": "^8.1.0",
    "commander": "^15.0.0",
    "fast-glob": "^3.3.3",
    "htmlparser2": "^12.0.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@babel/types": "^8.1.0",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
